# AnonTrove Environment Configuration Example
# Copy to .env.local for local development. Never commit .env.local to Git.

# Administrative Access Guard (Required to access /admin and /api/admin/*)
ADMIN_ACCESS_SECRET=replace_with_a_secure_random_64_character_admin_secret

# Ebook Download & Token Encryption (AES-256-GCM 32-byte secret)
DOWNLOAD_ENCRYPTION_SECRET=replace_with_a_secure_random_64_character_encryption_secret

# FamGateway UPI Integration (Merchant Non-Custodial UPI)
FAMGATEWAY_API_KEY=fam_live_placeholder_replace_with_real_key
FAMGATEWAY_BASE_URL=https://famgateway.in
FAMGATEWAY_POLL_URL=https://famgateway.in/api/checkout-status.php

# Razorpay Integration (Optional multi-gateway)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Cashfree Payments Integration (Optional multi-gateway)
CASHFREE_APP_ID=cf_app_id_placeholder
CASHFREE_SECRET_KEY=cf_secret_key_placeholder
CASHFREE_ENV=PRODUCTION

# Cloudflare R2 Private Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=cloudflare_account_id_placeholder
CLOUDFLARE_R2_ACCESS_KEY_ID=cloudflare_access_key_placeholder
CLOUDFLARE_R2_SECRET_ACCESS_KEY=cloudflare_secret_key_placeholder
CLOUDFLARE_R2_BUCKET_NAME=anontrove-ebooks-vault

# Supabase PostgreSQL Database (Optional database layer)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key_placeholder

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://ebook-sandy-chi.vercel.app
PAYMENT_REDIRECT_URL=https://ebook-sandy-chi.vercel.app/success
NEXT_PUBLIC_STORE_NAME=AnonTrove
NEXT_PUBLIC_STORE_TAGLINE=Zero-Trace Digital Bookshelf & Secure Knowledge Vault

# Support
SUPPORT_EMAIL=apnix7@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=apnix7@gmail.com

# Telegram storage channel (Bot token still required separately)
TELEGRAM_STORAGE_CHANNEL_ID=@coding_with_ujjwal
TELEGRAM_BOT_TOKEN=

# Cron auth
CRON_SECRET=replace_with_cron_secret
